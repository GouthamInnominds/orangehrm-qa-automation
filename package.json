{
  "name": "orangehrm-qa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone QA Automation Repository (Playwright TypeScript, Cypress Integration, E2E/API/RBAC Scripts) integrated with OrangeHRM QKG & QE Workbench",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e",
    "test:smoke": "playwright test tests/smoke",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open -e runner=interactive",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "axios": "~1.13.1",
    "cypress": "^13.6.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-jest": "^27.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.6.0"
  }
}
